{
  "version": 1,
  "description": "Follow-ups that refine the active analysis, and new questions that must not inherit its constraints.",
  "cases": [
    {
      "id": "follow-up/compare-previous-year",
      "title": "A comparison follow-up keeps product, period and grouping",
      "status": "active",
      "source": "curated",
      "tags": ["follow-up", "comparison", "multi-turn"],
      "today": "2026-10-05",
      "turns": [
        {
          "user": "Quanto vendi de maçã por mês nos últimos 3 meses?",
          "fixture": {
            "interpretation": {
              "measure": "net_value",
              "filters": { "product": "maçã" },
              "period": {
                "kind": "last",
                "unit": "month",
                "count": 3,
                "includeCurrent": false
              },
              "groupBy": "month"
            }
          },
          "expect": {
            "kind": "answer",
            "query": {
              "productSearch": "maçã",
              "startDate": "2026-07-01",
              "endDate": "2026-09-30",
              "metric": "net_value",
              "groupBy": "month",
              "comparison": "none"
            }
          }
        },
        {
          "user": "E comparado ao mesmo período do ano passado?",
          "fixture": {
            "interpretation": {
              "relation": "refine",
              "comparison": "previous_year"
            }
          },
          "expect": {
            "kind": "answer",
            "query": {
              "productSearch": "maçã",
              "startDate": "2026-07-01",
              "endDate": "2026-09-30",
              "metric": "net_value",
              "groupBy": "month",
              "comparison": "previous_year"
            }
          }
        }
      ]
    },
