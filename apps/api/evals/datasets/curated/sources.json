{
  "version": 1,
  "description": "The interface source selector decides which sales sources run; source names in the message never select, add or filter a source.",
  "cases": [
    {
      "id": "source/selector-vrmaster",
      "title": "Pilar da Terra (VR Master) selected queries only VRMaster",
      "status": "active",
      "source": "curated",
      "tags": ["source", "routing"],
      "today": "2026-10-07",
      "turns": [
        {
          "user": "Quanto vendi em setembro?",
          "source": "vrmaster",
          "fixture": {
            "interpretation": {
              "measure": "net_value",
              "period": { "kind": "month", "month": 9, "year": 2026 }
            }
          },
          "expect": {
            "route": "sales",
            "kind": "answer",
            "sources": ["vrmaster"],
            "sourceNotice": false,
            "query": {
              "productSearch": null,
              "startDate": "2026-09-01",
              "endDate": "2026-09-30",
              "metric": "net_value"
            }
          }
        }
      ]
    },
    {
      "id": "source/all-queries-both",
      "title": "Tudo queries both sources with the same plan",
      "status": "active",
      "source": "curated",
      "tags": ["source", "routing", "product"],
      "today": "2026-10-07",
      "turns": [
        {
          "user": "Quanto vendi de maçã em setembro?",
          "source": "all",
          "fixture": {
            "interpretation": {
              "measure": "net_value",
              "filters": { "product": "maçã" },
              "period": { "kind": "month", "month": 9, "year": 2026 }
            }
          },
          "expect": {
            "kind": "answer",
            "sources": ["sankhya", "vrmaster"],
            "query": {
              "productSearch": "maçã",
              "startDate": "2026-09-01",
              "endDate": "2026-09-30"
            }
          }
        }
      ]
    },
    {
