            }
          },
          "expect": {
            "route": "sales",
            "kind": "answer",
            "sources": ["sankhya"],
            "sourceNotice": true,
            "query": {
              "productSearch": null,
              "startDate": "2026-09-01",
              "endDate": "2026-09-30"
            }
          }
        }
      ]
    },
    {
