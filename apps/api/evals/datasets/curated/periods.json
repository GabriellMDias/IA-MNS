{
  "version": 1,
  "description": "Single-turn period interpretation resolved against the Sao Paulo business date, including unqueryable periods.",
  "cases": [
    {
      "id": "period/current-year-to-date",
      "title": "This year means year to date",
      "status": "active",
      "source": "curated",
      "tags": ["period"],
      "today": "2026-10-05",
      "turns": [
        {
          "user": "Quanto vendemos este ano?",
          "fixture": {
            "interpretation": {
              "measure": "net_value",
              "period": {
                "kind": "current",
                "unit": "year"
              }
            }
          },
          "expect": {
            "kind": "answer",
            "query": {
              "productSearch": null,
              "startDate": "2026-01-01",
              "endDate": "2026-10-05",
              "metric": "net_value",
              "groupBy": "total",
              "comparison": "none"
            }
          }
        }
      ]
    },
    {
      "id": "period/last-three-months-completed",
      "title": "Last three months are the completed months before the current one",
      "status": "active",
      "source": "curated",
      "tags": ["period"],
      "today": "2026-10-05",
      "turns": [
        {
          "user": "Vendas dos últimos 3 meses",
          "fixture": {
            "interpretation": {
              "period": {
                "kind": "last",
                "unit": "month",
                "count": 3,
                "includeCurrent": false
              }
            }
          },
          "expect": {
            "kind": "answer",
            "query": {
              "startDate": "2026-07-01",
              "endDate": "2026-09-30"
            }
          }
        }
      ]
    },
    {
      "id": "period/last-three-months-including-current",
