{
  "name": "@ia-mns/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "dev:lan": "tsx scripts/local-network.ts",
    "db:generate": "prisma generate",
    "db:local": "tsx scripts/local-database.ts",
    "identity:local": "tsx scripts/local-identity.ts",
    "sankhya:local": "tsx scripts/local-sankhya.ts",
    "pdt:local": "tsx scripts/local-pdt.ts",
    "identity:bootstrap": "node --env-file-if-exists=../../.env.local --import tsx scripts/identity-bootstrap.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=../../.env.local --import tsx evals/cli.ts",
    "references:write": "tsx scripts/generate-references.ts --write",
    "references:check": "tsx scripts/generate-references.ts --check"
  },
  "dependencies": {
    "@fastify/otel": "0.21.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/instrumentation": "7.10.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "openai": "7.25.0",
    "oracledb": "7.0.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/oracledb": "7.0.3",
    "@types/pg": "8.16.0",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
