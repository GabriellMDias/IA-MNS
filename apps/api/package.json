{
  "name": "@ia-mns/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/local-runner.ts --watch src/main.ts",
    "dev:lan": "tsx scripts/local-network.ts",
    "db:generate": "prisma generate",
    "db:local": "tsx scripts/local-database.ts",
    "identity:local": "tsx scripts/local-identity.ts",
