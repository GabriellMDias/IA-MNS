    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/instrumentation": "7.10.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.6",
    "jose": "6.2.12",
