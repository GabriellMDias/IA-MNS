    "db:deploy": "tsx src/cli/database-deploy.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
