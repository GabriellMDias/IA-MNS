    "references:write": "tsx scripts/generate-references.ts --write",
    "references:check": "tsx scripts/generate-references.ts --check",
    "erp:discovery": "tsx scripts/local-runner.ts scripts/erp-discovery.ts",
    "erp:runtime:access": "tsx scripts/erp-runtime-access.ts",
    "erp:runtime:audit": "tsx scripts/runtime-access-audit.ts",
    "erp:runtime:verify": "tsx scripts/runtime-access-verify.ts"
