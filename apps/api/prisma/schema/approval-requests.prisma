// Approval Request reference model. Foundation-only: derived projects start
// without it and add their own model files to this folder.

enum ApprovalRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id                String                @id @default(uuid()) @db.Uuid
  creatorId         String                @map("creator_id") @db.Uuid
  title             String                @db.VarChar(200)
  description       String?               @db.VarChar(2000)
  status            ApprovalRequestStatus @default(DRAFT)
  version           Int                   @default(1)
  rejectionReason   String?               @map("rejection_reason") @db.VarChar(2000)
  idempotencyKey    String                @map("idempotency_key") @db.VarChar(200)
  intentFingerprint String                @map("intent_fingerprint") @db.VarChar(64)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([creatorId, idempotencyKey], map: "approval_requests_creator_key_unique")
  @@index([creatorId, createdAt(sort: Desc), id(sort: Desc)], map: "approval_requests_mine_page_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "approval_requests_review_page_idx")
  @@map("approval_requests")
}
