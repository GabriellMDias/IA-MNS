model IdentityPerson {
  id          String   @id @db.Uuid
  displayName String   @map("display_name") @db.VarChar(120)
  status      String   @default("active") @db.VarChar(16)
  mergedInto  String?  @map("merged_into") @db.Uuid
  mergedTarget IdentityPerson? @relation("IdentityPersonMerge", fields: [mergedInto], references: [id], onDelete: Restrict)
  mergedSources IdentityPerson[] @relation("IdentityPersonMerge")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  externalIdentities IdentityExternalIdentity[]
  localCredential    IdentityLocalCredential?
  recoveryCodes      IdentityRecoveryCode[]
  sessions           IdentitySession[]
  roles              IdentityRoleAssignment[]
  grants             IdentityCapabilityGrant[]
  tickets            IdentityTicket[]
  trustedDevices     IdentityTrustedDevice[]
  policyUpdates      IdentitySecurityPolicy[]
  @@index([displayName, id], map: "identity_persons_display_name_idx")
  @@map("identity_persons")
}

model IdentityExternalIdentity {
  id             String   @id @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  person         IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  provider       String   @db.VarChar(16)
  issuer         String   @db.VarChar(300)
  subject        String   @db.VarChar(200)
  label          String?  @db.VarChar(200)
  email          String?  @db.VarChar(254)
  establishedBy  String   @default("proof") @map("established_by") @db.VarChar(16)
  linkedBy       String?  @map("linked_by") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastVerifiedAt DateTime @default(now()) @map("last_verified_at") @db.Timestamptz(3)
  @@unique([provider, issuer, subject], map: "identity_external_identities_subject_key")
  @@unique([personId, provider, issuer], map: "identity_external_identities_person_provider_key")
  @@index([email], map: "identity_external_identities_email_idx")
  @@map("identity_external_identities")
}

model IdentityLocalCredential {
  personId          String    @id @map("person_id") @db.Uuid
  person            IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  login             String    @unique(map: "identity_local_credentials_login_key") @db.VarChar(64)
  passwordHash      String    @map("password_hash") @db.VarChar(200)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  totpSecret        String?   @map("totp_secret") @db.VarChar(200)
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  totpLastStep      BigInt?   @map("totp_last_step")
  @@map("identity_local_credentials")
}

model IdentityRecoveryCode {
  id        String    @id @db.Uuid
  personId  String    @map("person_id") @db.Uuid
  person    IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  codeHash  String    @unique(map: "identity_recovery_codes_hash_key") @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  @@index([personId], map: "identity_recovery_codes_person_idx")
  @@map("identity_recovery_codes")
}

model IdentitySession {
  id                  String    @id @db.Uuid
  personId            String    @map("person_id") @db.Uuid
  person              IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  method              String    @db.VarChar(16)
  surface             String    @db.VarChar(16)
  assurance           String    @db.VarChar(8)
  refreshHash         String?   @unique(map: "identity_sessions_refresh_key") @map("refresh_hash") @db.Char(64)
  previousRefreshHash String?   @unique(map: "identity_sessions_previous_refresh_key") @map("previous_refresh_hash") @db.Char(64)
  authTime            DateTime  @map("auth_time") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt          DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt       DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason       String?   @map("revoked_reason") @db.VarChar(40)
  refreshRotatedAt    DateTime? @map("refresh_rotated_at") @db.Timestamptz(3)
  @@index([personId, createdAt(sort: Desc)], map: "identity_sessions_person_idx")
  @@index([expiresAt], map: "identity_sessions_expiry_idx")
  @@map("identity_sessions")
}

model IdentityRoleAssignment {
  personId  String   @map("person_id") @db.Uuid
  person    IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      String   @db.VarChar(40)
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  @@id([personId, role], map: "identity_role_assignments_pkey")
  @@index([role], map: "identity_role_assignments_role_idx")
  @@map("identity_role_assignments")
}

model IdentityCapabilityGrant {
  personId   String   @map("person_id") @db.Uuid
  person     IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  permission String   @db.VarChar(80)
  grantedBy  String?  @map("granted_by") @db.Uuid
  grantedAt  DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  @@id([personId, permission], map: "identity_capability_grants_pkey")
  @@map("identity_capability_grants")
}

model IdentityTicket {
  id         String    @id @db.Uuid
  purpose    String    @db.VarChar(24)
  tokenHash  String    @unique(map: "identity_tickets_token_key") @map("token_hash") @db.Char(64)
  personId   String?   @map("person_id") @db.Uuid
  person     IdentityPerson? @relation(fields: [personId], references: [id], onDelete: Cascade)
  payload    Json      @default("{}")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  @@index([expiresAt], map: "identity_tickets_expiry_idx")
  @@map("identity_tickets")
}

model IdentityUsedAssertion {
  jtiHash   String   @id @map("jti_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@map("identity_used_assertions")
}

model IdentityAuditEvent {
  id             String   @id @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  action         String   @db.VarChar(48)
  actorPersonId  String?  @map("actor_person_id") @db.Uuid
  targetPersonId String?  @map("target_person_id") @db.Uuid
  details        Json     @default("{}")
  @@index([targetPersonId, occurredAt(sort: Desc)], map: "identity_audit_events_target_idx")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "identity_audit_events_recent_idx")
  @@map("identity_audit_events")
}

model IdentitySecurityPolicy {
  id                     Int      @id @default(1) @db.SmallInt
  sessionMaxMinutes      Int      @map("session_max_minutes")
  idleTimeoutMinutes     Int      @map("idle_timeout_minutes")
  recentAuthMinutes      Int      @map("recent_auth_minutes")
  adminRecentAuthMinutes Int      @map("admin_recent_auth_minutes")
  mfaRequirement         String   @map("mfa_requirement") @db.VarChar(16)
  rememberDeviceDays     Int      @map("remember_device_days") @db.SmallInt
  updatedBy              String?  @map("updated_by") @db.Uuid
  updater                IdentityPerson? @relation(fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  @@map("identity_security_policies")
}

model IdentityTrustedDevice {
  id         String    @id @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  person     IdentityPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique(map: "identity_trusted_devices_token_key") @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([personId], map: "identity_trusted_devices_person_idx")
  @@map("identity_trusted_devices")
}
