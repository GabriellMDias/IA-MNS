{
  "kind": "database",
  "name": "identity_local_credentials",
  "description": "Optional IA-MNS local sign-in: unique login, memory-hard password verifier, lockout state and encrypted TOTP secret for strong authentication.",
  "owner": "identity",
  "classification": "RESTRICTED",
  "lifecycle": "Replaced on password change or owner-issued reset; TOTP reset by the Person or an owner reset. Deleted only with the Person.",
  "columns": [
    {
      "Column": "person_id",
      "PostgreSQL type": "uuid",
      "Nullable": "no",
      "Default": "—",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Owning Person; at most one local credential.",
      "Null meaning": "—",
      "Unit": "—"
    },
    {
      "Column": "login",
      "PostgreSQL type": "character varying(64)",
      "Nullable": "no",
      "Default": "—",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Normalized lowercase sign-in name; unique and not an e-mail requirement.",
      "Null meaning": "—",
      "Unit": "—"
    },
    {
      "Column": "password_hash",
      "PostgreSQL type": "character varying(200)",
      "Nullable": "no",
      "Default": "—",
      "Classification": "RESTRICTED",
      "Meaning": "scrypt verifier with parameters and salt; never returned or logged.",
      "Null meaning": "—",
      "Unit": "—"
    },
    {
      "Column": "password_changed_at",
      "PostgreSQL type": "timestamp(3) with time zone",
      "Nullable": "no",
      "Default": "CURRENT_TIMESTAMP",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Application-clock instant of the last password change.",
      "Null meaning": "—",
      "Unit": "—"
    },
    {
      "Column": "failed_attempts",
      "PostgreSQL type": "integer",
      "Nullable": "no",
      "Default": "0",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Consecutive failed password or second-factor attempts since the last success; drives temporary lockout.",
      "Null meaning": "—",
      "Unit": "—"
    },
    {
      "Column": "locked_until",
      "PostgreSQL type": "timestamp(3) with time zone",
      "Nullable": "yes",
      "Default": "—",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Application-clock end of a temporary lockout.",
      "Null meaning": "No active lockout.",
      "Unit": "—"
    },
    {
      "Column": "totp_secret",
      "PostgreSQL type": "character varying(200)",
      "Nullable": "yes",
      "Default": "—",
      "Classification": "RESTRICTED",
      "Meaning": "AES-256-GCM encrypted RFC 6238 secret (IA_MNS_IDENTITY_ENCRYPTION_KEY).",
      "Null meaning": "No second factor enrolled.",
      "Unit": "—"
    },
    {
      "Column": "totp_enabled_at",
      "PostgreSQL type": "timestamp(3) with time zone",
      "Nullable": "yes",
      "Default": "—",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Instant the second factor was confirmed with a valid code.",
      "Null meaning": "Second factor not enabled.",
      "Unit": "—"
    },
    {
      "Column": "totp_last_step",
      "PostgreSQL type": "bigint",
      "Nullable": "yes",
      "Default": "—",
      "Classification": "CONFIDENTIAL",
      "Meaning": "Last accepted 30-second TOTP step; prevents code reuse.",
      "Null meaning": "No code accepted yet.",
      "Unit": "—"
    }
  ],
  "constraints": [
    {
      "Object": "identity_local_credentials_attempts_check",
      "Physical definition": "CHECK ((failed_attempts >= 0))",
      "Purpose": "Nonnegative failure counter."
    },
    {
      "Object": "identity_local_credentials_login_check",
      "Physical definition": "CHECK (((login)::text ~ '^[a-z0-9][a-z0-9._-]{2,63}$'::text))",
      "Purpose": "Normalized login alphabet and length."
    },
    {
      "Object": "identity_local_credentials_person_id_fkey",
      "Physical definition": "FOREIGN KEY (person_id) REFERENCES identity_persons(id) ON UPDATE CASCADE ON DELETE CASCADE",
      "Purpose": "Credential belongs to its Person."
    },
    {
      "Object": "identity_local_credentials_pkey",
      "Physical definition": "PRIMARY KEY (person_id)",
      "Purpose": "One credential per Person."
    },
    {
      "Object": "identity_local_credentials_totp_check",
      "Physical definition": "CHECK (((totp_enabled_at IS NULL) OR (totp_secret IS NOT NULL)))",
      "Purpose": "An enabled factor has a secret."
    },
    {
      "Object": "identity_local_credentials_login_key",
      "Physical definition": "CREATE UNIQUE INDEX identity_local_credentials_login_key ON public.identity_local_credentials USING btree (login)",
      "Purpose": "Unique sign-in name."
    }
  ]
}
