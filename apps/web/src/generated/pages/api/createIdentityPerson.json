          "required": ["displayName", "localInvitation"],
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "localInvitation": { "type": "boolean" },
            "sankhyaUser": { "type": "string", "pattern": "^[1-9][0-9]{0,9}$" },
            "linkInvitations": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "string", "const": "pdt" },
                  { "type": "string", "const": "sankhya" }
                ]
              },
              "maxItems": 2,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    },
