# /etc/ia-mns/runtime.env — the application's environment (root:root 0600).
# Names and meaning: docs/generated/configuration/api.md. Never add
# ORION_MIGRATION_DATABASE_URL, POSTGRES_PASSWORD or development settings here;
# `ia-mns-deploy check-config` refuses them. Values marked __GENERATE_...__ are
# filled by `ia-mns-deploy init-secrets`; CHANGE_ME values come from you.
ORION_ENV=production
ORION_LOG_LEVEL=info
# Longer than the default so in-flight requests finish during a deployment.
ORION_SHUTDOWN_TIMEOUT_MS=20000

# Runtime database credential (restricted role orion_runtime).
ORION_DATABASE_URL=postgresql://orion_runtime:__GENERATE_RUNTIME_PASSWORD__@postgres:5432/ia_mns

# Public HTTPS origin of IA-MNS, exactly as browsers see it (no trailing slash).
IA_MNS_PUBLIC_ORIGIN=CHANGE_ME
IA_MNS_IDENTITY_SIGNING_KEY=__GENERATE_IDENTITY_SIGNING_KEY__
IA_MNS_IDENTITY_ENCRYPTION_KEY=__GENERATE_IDENTITY_ENCRYPTION_KEY__

# Only the reverse proxy's own address(es) as the container sees them (PH-22).
# Unset trusts no forwarded header; never a broad network.
ORION_TRUSTED_PROXIES=CHANGE_ME

# Internal TLS on the proxy-to-application hop (PH-22): uncomment both to listen
# with HTTPS, with the files placed in /etc/ia-mns/tls/.
# ORION_TLS_CERT_FILE=/run/ia-mns/tls/tls.crt
# ORION_TLS_KEY_FILE=/run/ia-mns/tls/tls.key

# Dedicated production OpenAI project key (PH-23).
OPENAI_API_KEY=CHANGE_ME
# OPENAI_MODEL=gpt-6.1-sol

# Sankhya Oracle: the dedicated SELECT-only reader (PH-08) and its transport
# protection (PH-25). Production refuses to start without this connection.
SANKHYA_DB_USER=CHANGE_ME
SANKHYA_DB_PASSWORD=CHANGE_ME
SANKHYA_DB_CONNECT_STRING=CHANGE_ME
# Read-only user view and fixed installation identifier for owner directory
# association (PH-08). The issuer never changes once links exist.
# SANKHYA_IDENTITY_ISSUER=
# SANKHYA_DIRECTORY_VIEW=

# VRMaster source: leave unset until PH-20 and PH-21 are resolved.
# VRMASTER_DB_HOST=
# VRMASTER_DB_PORT=5432
# VRMASTER_DB_NAME=
# VRMASTER_DB_USER=
# VRMASTER_DB_PASSWORD=
# VRMASTER_DB_SSL_MODE=verify-full

# PDT Connect sign-in and embedding: leave unset until PH-12.
# PDT_IDENTITY_BASE_URL=
# PDT_IDENTITY_ISSUER=
# PDT_IDENTITY_CLIENT_ID=
# PDT_IDENTITY_CLIENT_SECRET=
# PDT_IDENTITY_REDIRECT_URI=<public origin>/api/identity/pdt/callback
# PDT_EMBED_ORIGIN=

# Sankhya Om sign-in and embedding: leave unset until PH-11, PH-14 and PH-17.
# SANKHYA_IDENTITY_KEYS=
# SANKHYA_IDENTITY_AUTHORIZE_URL=
# SANKHYA_EMBED_ORIGIN=
# SANKHYA_SESSION_TRUST=pending

# Installation defaults of operational parameters (owners override them in
# Administração → Parâmetros). Content tracing is refused in production.
# IA_MNS_AI_TRACE=metadata
# IA_MNS_PROVIDER_GRANTS=
