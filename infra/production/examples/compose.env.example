# /etc/ia-mns/compose.env — deployment settings, not secrets (root:root 0600).
# Read by ia-mns-deploy and Docker Compose; never passed to the application.

# Host address and port the application is published on. Use the address the
# reverse proxy reaches (an internal interface, or 127.0.0.1 when the proxy runs
# on this host); never 0.0.0.0. The container listens on 3000.
IA_MNS_BIND_ADDRESS=CHANGE_ME
IA_MNS_HTTP_PORT=4490

# Repository that releases are fetched from, and the GitHub repository whose
# required check must have passed on a release's commit. Leave
# IA_MNS_CI_REPOSITORY empty only where GitHub cannot be reached; the
# deployment record then says that CI was not verified.
IA_MNS_GIT_REMOTE=https://github.com/GabriellMDias/IA-MNS.git
IA_MNS_CI_REPOSITORY=GabriellMDias/IA-MNS
IA_MNS_REQUIRED_CHECK=Orion required gate

# Optional: the URL the post-deployment smoke test uses. Defaults to
# http://IA_MNS_BIND_ADDRESS:IA_MNS_HTTP_PORT (https:// with internal TLS).
IA_MNS_SMOKE_URL=

# Optional: a command run with a one-line message when a backup, restore
# verification or deployment fails (for example a mail or chat notifier).
# Pending the alert channel decision (PH-24).
IA_MNS_ALERT_COMMAND=
