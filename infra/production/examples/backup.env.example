# /etc/ia-mns/backup.env — backup settings (root:root 0600). Retention values
# are conservative defaults pending the owner's decision (PH-09).
IA_MNS_BACKUP_KEEP_DAILY=14
IA_MNS_BACKUP_KEEP_PREDEPLOY=10

# External copy, required for production (PH-24). Backups are encrypted with
# age for this public recipient before leaving the host; the private key is
# kept offline by its owner, never on this server or in backups.
IA_MNS_BACKUP_AGE_RECIPIENT=
# A mounted directory (absolute path) or an rsync-over-SSH target
# (user@host:/path). Empty: no external copy, and status reports that the
# installation does not meet the production backup requirement.
IA_MNS_BACKUP_EXTERNAL_TARGET=
# SSH private key for an rsync target (path on this host, root-only).
IA_MNS_BACKUP_SSH_KEY=
