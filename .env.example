# Local API development example. Copy to .env.local; never commit real values.
# The keys and safe defaults below are checked against apps/api/src/config.ts.
# See docs/setup.md and docs/generated/configuration/api.md.
ORION_ENV=development

# ORION_RELEASE_ID=local  # Actual artifact revision for correlated logs and traces; local for unversioned development.
# ORION_API_HOST=127.0.0.1  # Listen address; loopback by default.
# ORION_API_PORT=3000  # Listen port; zero selects an ephemeral port.
# ORION_LOG_LEVEL=info  # Structured log threshold.
# ORION_SHUTDOWN_TIMEOUT_MS=5000  # Total graceful shutdown deadline.
# ORION_OTLP_ENDPOINT: Optional OTLP HTTP collector base URL.
# ORION_TRACE_SAMPLE_RATIO=1  # Trace sampling probability.
# ORION_DATABASE_URL: Runtime PostgreSQL credential; enables the database for modules that require it and adds it to readiness.
# ORION_TOKEN_ISSUER: Expected access-token issuer; configure with audience and JWKS URL to enable bearer authentication.
# ORION_TOKEN_AUDIENCE: Expected API access-token audience.
# ORION_TOKEN_JWKS_URL: Trusted issuer public-key endpoint.
# OPENAI_API_KEY: Dedicated IA-MNS project key; required for agent routing and capability interpretation.
# OPENAI_MODEL=gpt-6.1-sol  # Responses API model supporting strict function calling.
# SANKHYA_DB_USER: Oracle account with CREATE SESSION and only SELECT grants on the sales reference tables.
# SANKHYA_DB_PASSWORD: Restricted Oracle account password; configure with user and connect string.
# SANKHYA_DB_CONNECT_STRING: Oracle Easy Connect or full descriptor, without embedded credentials.
# SANKHYA_ORACLE_CLIENT_LIB_DIR: Optional Oracle Client 19+ library directory; enables Thick mode when needed.
# IA_MNS_LOCAL_ACCESS=false  # Explicit local development access; forbidden in production or on a non-loopback listener.
# IA_MNS_DEV_ACCESS_TOKEN: Temporary bearer for an owner-controlled LAN test; non-production loopback API only, paired with origin and expiration. Never browser configuration.
# IA_MNS_DEV_ACCESS_ORIGIN: Exact browser origin for the temporary LAN test; no credentials, path or wildcard.
# IA_MNS_DEV_ACCESS_EXPIRES_AT: Absolute temporary bearer expiry; at most two hours after startup. Checked on every request, not renewed.
