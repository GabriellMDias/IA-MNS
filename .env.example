# Local API development example. Copy to .env.local; never commit real values.
# The keys and safe defaults below are checked against apps/api/src/config.ts.
# See docs/setup.md and docs/generated/configuration/api.md.
ORION_ENV=development

# ORION_RELEASE_ID=local  # Actual artifact revision for correlated logs and traces; local for unversioned development.
# ORION_API_HOST=127.0.0.1  # Listen address; loopback by default.
# ORION_API_PORT=3000  # Listen port; zero selects an ephemeral port.
# ORION_LOG_LEVEL=info  # Structured log threshold.
# ORION_SHUTDOWN_TIMEOUT_MS=5000  # Total graceful shutdown deadline.
# ORION_OTLP_ENDPOINT: Optional OTLP HTTP collector base URL.
# ORION_TRACE_SAMPLE_RATIO=1  # Trace sampling probability.
# ORION_DATABASE_URL: Runtime PostgreSQL credential; enables the database for modules that require it and adds it to readiness.
# ORION_TOKEN_ISSUER: Expected access-token issuer; configure with audience and JWKS URL to enable bearer authentication.
# ORION_TOKEN_AUDIENCE: Expected API access-token audience.
# ORION_TOKEN_JWKS_URL: Trusted issuer public-key endpoint.
# OPENAI_API_KEY: Dedicated IA-MNS project key; required for agent routing and capability interpretation.
# OPENAI_MODEL=gpt-6.1-sol  # Responses API model supporting strict function calling.
# IA_MNS_AI_TRACE=metadata  # AI turn tracing: metadata logs allowlisted decisions, timings and token counts without user content; content also stores confidential interpretation traces with each turn and is refused in production until PH-09.
# SANKHYA_DB_USER: Oracle account with CREATE SESSION and only SELECT grants on the sales reference tables.
# SANKHYA_DB_PASSWORD: Restricted Oracle account password; configure with user and connect string.
# SANKHYA_DB_CONNECT_STRING: Oracle Easy Connect or full descriptor, without embedded credentials.
# SANKHYA_ORACLE_CLIENT_LIB_DIR: Optional Oracle Client 19+ library directory; enables Thick mode when needed.
# IA_MNS_LOCAL_ACCESS=false  # Explicit local development access; forbidden in production or on a non-loopback listener.
# IA_MNS_DEV_ACCESS_TOKEN: Temporary bearer for an owner-controlled LAN test; non-production loopback API only, paired with origin and expiration. Never browser configuration.
# IA_MNS_DEV_ACCESS_ORIGIN: Exact browser origin for the temporary LAN test; no credentials, path or wildcard.
# IA_MNS_DEV_ACCESS_EXPIRES_AT: Absolute temporary bearer expiry; at most two hours after startup. Checked on every request, not renewed.
# IA_MNS_PUBLIC_ORIGIN: Browser origin of the IA-MNS web application; token issuer and redirect target for sign-in flows. HTTPS in production; enables identity together with the signing and encryption keys.
# IA_MNS_IDENTITY_SIGNING_KEY: Signs IA-MNS access tokens (ES256). Generate with pnpm identity:keys; never browser configuration.
# IA_MNS_IDENTITY_ENCRYPTION_KEY: AES-256-GCM key for TOTP secrets at rest. Rotation requires re-enrollment of second factors.
# IA_MNS_IDENTITY_AUDIENCE=ia-mns-api  # Audience of IA-MNS access tokens.
# IA_MNS_PROVIDER_GRANTS: Optional narrowing of automatic read grants by provider link; unset uses the composed capability defaults, none disables them.
# PDT_IDENTITY_BASE_URL: PDT Connect origin serving the identity contract; configure with issuer, client and redirect URI.
# PDT_IDENTITY_ISSUER: Exact PDT_IDENTITY_ISSUER of the PDT installation; link issuer for PDT identities.
# PDT_IDENTITY_CLIENT_ID: IA-MNS client id registered in PDT_IDENTITY_CLIENTS.
# PDT_IDENTITY_CLIENT_SECRET: IA-MNS client secret for the PDT contract; PDT stores only its SHA-256.
# PDT_IDENTITY_REDIRECT_URI: Exact callback registered in PDT; the browser-visible URL of GET /identity/pdt/callback.
# PDT_EMBED_ORIGIN: Only PDT origin allowed to host the embedded IA-MNS and exchange bridge messages.
# SANKHYA_IDENTITY_ISSUER: Fixed identifier of the Sankhya installation: issuer of CODUSU links (owner directory association) and expected in Om host assertions.
# SANKHYA_IDENTITY_KEYS: Pinned public keys of the Om identity add-on (RS256/ES256). Private key material is rejected.
# SANKHYA_IDENTITY_AUTHORIZE_URL: Om add-on page that mints an assertion for the direct-URL sign-in.
# SANKHYA_EMBED_ORIGIN: Only Om origin allowed to host the embedded IA-MNS and exchange bridge messages.
# SANKHYA_DIRECTORY_VIEW: Read-only Sankhya user view (CODUSU, NOMEUSU, NOMEUSUCPLT, EMAIL, DTLIMACESSO) that lets owners associate real Sankhya users; unset disables the directory (PH-08).
# SANKHYA_SESSION_TRUST=pending  # Human gate for Om-session sign-in in production (PH-11); production refuses the Sankhya connector until approved.
